%div.product-card.bg-white.rounded-2xl.shadow-md.hover:shadow-lg.transition-all.p-4.flex.flex-col
  - if @product.photos.any?
    = image_tag @product.photos.first.image_url, class: "rounded-xl mb-3 w-full h-48 object-cover"
  - if @product.created_at > 1.week.ago
    %span.absolute.top-2.left-2.bg-green-500.text-white.text-xs.font-semibold.px-2.py-1.rounded-lg.uppercase Nowość
  
  %h3.text-lg.font-semibold.text-gray-800.mt-1= @product.name
  %p.text-sm.text-gray-500.truncate.mt-1= @product.description || "Brak opisu"
  - if @product.discount_price.present?
    %p.text-gray-500.line-through.mt-2= number_to_currency(@product.price)
    %p.text-red-600.font-bold= number_to_currency(@product.discount_price)
  - else
    %p.text-gray-800.font-semibold.mt-2= number_to_currency(@product.price)

  - if @product.stock > 0
    %span.text-sm.text-green-600.mt-1 Dostępny (#{@product.stock} szt.)
  - else
    %span.text-sm.text-red-600.mt-1 Brak w magazynie
  
  %div.flex.items-center.mt-2
    - filled_stars = @product.rating.to_i
    - empty_stars = 5 - filled_stars
    - filled_stars.times do
      %span.text-yellow-400 ⭐
    - empty_stars.times do
      %span.text-gray-300 ☆
  
  %div.mt-auto.flex.items-center.justify-between
    = link_to 'Zobacz', ecommerce_product_path(@product), class: "text-blue-600 hover:text-blue-800 text-sm font-medium"
    = button_to 'Dodaj do koszyka',
        add_ecommerce_cart_path(product_id: @product.id),
        method: :post,
        class: "mt-4 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition-colors",
        data: { turbo: false }
